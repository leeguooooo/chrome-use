{
  "manifest_version": 3,
  "name": "chrome-use",
  "version": "0.5.103",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "sidePanel",
    "alarms",
    "idle",
    "webNavigation",
    "notifications",
    "identity",
    "identity.email",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_ext_action_title__",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "storage": {
    "managed_schema": "managed-schema.json"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "inspect-element": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "__MSG_ext_command_inspect_element__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inspect-frame.html",
        "inspect-frame.js",
        "inspect-frame.css",
        "theme.css",
        "inspect-frame-logic.js",
        "inspect-format.js",
        "i18n.js",
        "inspect-replies.js",
        "markdown.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
